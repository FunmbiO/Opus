{
  "name": "aide-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-css.mjs && vite build",
    "build:preview": "tsc --noEmit && vite build --mode preview",
    "typecheck": "tsc --noEmit",
    "build:demo": "tsc --noEmit && node scripts/check-css.mjs && vite build --mode demo",
    "check:demo": "npm run build:demo && node scripts/demo-check.mjs",
    "check:logo": "node scripts/check-logo.mjs",
    "check:css": "node scripts/check-css.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
