# Used by docker-compose.yml. Copy to .env on the server (it is git-ignored).
# Create a key at https://login.tailscale.com/admin/settings/keys
# Use a one-off, non-reusable key; it is only needed the first time the container joins.
TS_AUTHKEY=
# The name Opus gets on your tailnet: https://<name>.<your-tailnet>.ts.net
TS_HOSTNAME=opus
