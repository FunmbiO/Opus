# --- Anthropic ---
# Create a key at console.anthropic.com, then set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# --- Budget guard (USD, same currency as your API bill) ---
MONTHLY_TARGET_USD=22
ALERT_USD=100
HARD_STOP_USD=100
MAX_RUN_USD=0.25

# --- Gmail (run `npm run auth` to get the refresh token) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Phone alerts via Telegram (optional) ---
# Make a bot with @BotFather, send it a message, then find your chat id at
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Server ---
HOST=127.0.0.1
PORT=8787
# Set this before you ever expose the server beyond localhost.
API_TOKEN=
# Extra host names the server will answer to, comma separated. localhost, IP addresses and *.ts.net always work.
# Anything else is refused (this blocks DNS-rebinding attacks). Only needed if you use your own domain.
ALLOWED_HOSTS=
# Set to 1 to run triage every 15 minutes and the subscription scan on Mondays.
AUTORUN=0

# --- Bank (Plaid) -- read-only card transactions ---
# Free developer account at plaid.com. Start with PLAID_ENV=sandbox to try it with fake banks.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Only if your bank signs you in on its own website. Must be https and added in the Plaid dashboard.
PLAID_REDIRECT_URI=
# How often Opus checks for new transactions (minutes), and the size of a new charge that pings your phone (0 = never).
BANK_SYNC_MIN=10
BANK_ALERT_OVER=200
